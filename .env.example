# Copy this file to .env and fill in your own credentials.
# .env is git-ignored and must never be committed.
#
# The scripts read these via os.environ. Loading a .env file automatically
# requires the optional python-dotenv package:
#     pip install python-dotenv
# Without it, export the variables in your shell instead.

# ---- Ortex (app.ortex.com) -----------------------------------------------
# ORTEX_CSRF_TOKEN is the X-Csrftoken value from an authenticated browser
# session (DevTools -> Network -> any /API/v2/ request -> Request Headers).
ORTEX_EMAIL=
ORTEX_PASSWORD=
ORTEX_CSRF_TOKEN=

# ---- Trading Volatility (stocks.tradingvolatility.net) -------------------
TRADINGVOLATILITY_API_KEY=

# ---- Collective2 (collective2.com) ---------------------------------------
COLLECTIVE2_EMAIL=
COLLECTIVE2_PASSWORD=
# Optional. A pre-existing cookie jar as single-line JSON, e.g.
# COLLECTIVE2_COOKIES={"session":"abc123","sessiontracker":"def456"}
# Leave blank to let the script establish the session through the login form.
COLLECTIVE2_COOKIES=

# ---- Seeking Alpha (seekingalpha.com) ------------------------------------
SEEKINGALPHA_EMAIL=
SEEKINGALPHA_PASSWORD=